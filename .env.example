# Keep the actual .env file private and never commit real passwords or keys.
DATABASE_URL=sqlite:///./nurselearn.db

# Both values are required to bootstrap the first administrator.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Password reset email delivery. Keep SMTP credentials only in the server
# environment. Reset links use a one-time token and require HTTPS in production.
NURSELEARN_PUBLIC_BASE_URL=http://127.0.0.1:8000
# Optional comma-separated browser origins for deployments that don't proxy
# API requests through the same Firebase Hosting domain.
NURSELEARN_CORS_ALLOWED_ORIGINS=
NURSELEARN_SMTP_HOST=
NURSELEARN_SMTP_PORT=587
NURSELEARN_SMTP_USERNAME=
NURSELEARN_SMTP_PASSWORD=
NURSELEARN_SMTP_FROM_EMAIL=
NURSELEARN_SMTP_STARTTLS=true
NURSELEARN_SESSION_COOKIE_SECURE=false

# Optional OpenRouter settings. Use a model ID from your OpenRouter account.
# Never put the API key in HTML or JavaScript.
NURSELEARN_AI_BASE_URL=https://openrouter.ai/api/v1
NURSELEARN_AI_API_KEY=
NURSELEARN_AI_MODEL=google/gemini-3.8-flash

# Research is disabled unless all three settings are configured for an
# institutionally approved protocol and displayed consent statement.
NURSELEARN_RESEARCH_ENABLED=false
NURSELEARN_RESEARCH_PROTOCOL_ID=
NURSELEARN_RESEARCH_CONSENT_TEXT=
